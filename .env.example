# ===================================================
# COMPANIO AI VOICE AGENT FOR HEALTHCARE - ENV CONFIG
# ===================================================

# ---------------------------------------------------
# 1. DATABASE CONFIGURATION
# ---------------------------------------------------
# Local MongoDB or MongoDB Atlas Cloud Connection String
# Format: mongodb+srv://<username>:<password>@cluster.mongodb.net/companio?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/companio

# ---------------------------------------------------
# 2. SERVER & AUTHENTICATION CONFIGURATION
# ---------------------------------------------------
PORT=5000
NODE_ENV=development
APP_BASE_URL=http://localhost:5173
JWT_SECRET=super_secret_companio_jwt_token_key_change_in_production_2026

# ---------------------------------------------------
# 3. SPEECH-TO-TEXT (STT) - DEEPGRAM CONFIGURATION
# ---------------------------------------------------
# Deepgram Nova-2 streaming WebSocket transcription API Key
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# ---------------------------------------------------
# 4. CONVERSATIONAL LLM CONFIGURATION
# ---------------------------------------------------
# Google Gemini 2.0 Flash, OpenAI GPT-4o-mini, or Anthropic Claude API Key
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ---------------------------------------------------
# 5. TEXT-TO-SPEECH (TTS) - ELEVENLABS CONFIGURATION
# ---------------------------------------------------
# ElevenLabs Rachel voice preset (21m00Tcm4TlvDq8ikWAM)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ---------------------------------------------------
# 6. CLINICAL ESCALATION NOTIFICATIONS (SMS & EMAIL)
# ---------------------------------------------------
# Enable/Disable real SMS & Email alerts (set to true if keys provided)
ENABLE_SMS_ESCALATION=false
ENABLE_EMAIL_ESCALATION=false

# Twilio SMS Credentials
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890

# Nodemailer / SendGrid Email Credentials
SENDGRID_API_KEY=your_sendgrid_api_key_here
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_sendgrid_api_key_here

# Fallback Clinician Notification Contacts
CLINICIAN_NOTIFICATION_EMAIL=sjenkins@healthclinic.org
CLINICIAN_NOTIFICATION_PHONE=+15550192834
