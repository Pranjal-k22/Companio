# Multi-Stage Node.js Server Dockerfile for Companio Backend & Background Workers
FROM node:20-alpine AS base

# Install curl/wget for healthchecks and security updates
RUN apk add --no-cache curl wget

WORKDIR /app

# Copy root and server manifests
COPY package.json package-lock.json ./
COPY server/package.json server/package-lock.json ./server/

# Install dependencies (production-focused)
RUN npm ci --prefix server

# Copy server application source code
COPY server ./server

# Run as non-privileged user for container security
USER node

# Expose backend API and WebSocket port
EXPOSE 5000

ENV NODE_ENV=production
ENV PORT=5000

# Default entrypoint starts Express + Socket.io server
CMD ["node", "server/src/server.js"]
